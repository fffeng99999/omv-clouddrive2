msgid "CloudDrive2"
msgstr "CloudDrive2"

msgid "Updated CloudDrive2 settings."
msgstr "已更新 CloudDrive2 设置。"

msgid "Enabled"
msgstr "已启用"

msgid "Configuration directory"
msgstr "配置目录"

msgid "The directory where CloudDrive2 stores its configuration and data (CLOUDDRIVE_HOME). It must be located on a mounted filesystem."
msgstr "CloudDrive2 存储配置和数据的目录（CLOUDDRIVE_HOME）。该目录必须位于已挂载的文件系统上。"

msgid "The CloudDrive2 web interface listens on port 19798. After enabling the service, click Save and then Apply to start it. Use the Start/Stop/Restart buttons for immediate control."
msgstr "CloudDrive2 网页界面监听 19798 端口。启用服务后，点击“保存”再点击“应用”即可启动。也可使用“启动/停止/重启”按钮立即控制服务。"

msgid "Start"
msgstr "启动"

msgid "Stop"
msgstr "停止"

msgid "Restart"
msgstr "重启"

msgid "Do you really want to restart the CloudDrive2 service?"
msgstr "确定要重启 CloudDrive2 服务吗？"

msgid "CloudDrive2 service started."
msgstr "CloudDrive2 服务已启动。"

msgid "CloudDrive2 service stopped."
msgstr "CloudDrive2 服务已停止。"

msgid "CloudDrive2 service restarted."
msgstr "CloudDrive2 服务已重启。"

msgid "Open UI"
msgstr "打开界面"

msgid "Status"
msgstr "状态"

msgid "Service status"
msgstr "服务状态"

msgid "Running means the CloudDrive2 service is active on this machine."
msgstr "“运行中”表示 CloudDrive2 服务正在本机运行。"

msgid "Running"
msgstr "运行中"

msgid "Stopped"
msgstr "已停止"

msgid "CloudDrive2 version"
msgstr "CloudDrive2 版本"

msgid "Web interface port"
msgstr "Web 界面端口"

msgid "Settings"
msgstr "设置"

msgid "Start the CloudDrive2 service automatically at boot. Click Save and then Apply to take effect."
msgstr "开机自动启动 CloudDrive2 服务。点击“保存”后再点击“应用”生效。"

msgid "Update status"
msgstr "更新状态"

msgid "Click 'Check for updates' to query the upstream GitHub releases."
msgstr "点击“检查更新”查询上游 GitHub 发布版本。"

msgid "Latest version"
msgstr "最新版本"

msgid "Not checked"
msgstr "未检查"

msgid "Up to date"
msgstr "已是最新"

msgid "Update available"
msgstr "有可用更新"

msgid "Update channel"
msgstr "更新渠道"

msgid "The upstream release channel used when checking for updates and updating CloudDrive2."
msgstr "检查更新和更新 CloudDrive2 时使用的上游发布渠道。"

msgid "Stable (official releases)"
msgstr "正式版（稳定发布）"

msgid "Preview (beta releases)"
msgstr "预览版（测试发布）"

msgid "Check for updates"
msgstr "检查更新"

msgid "Checking for updates ..."
msgstr "正在检查更新…"

msgid "Update check finished. See the update status below."
msgstr "更新检查完成，请查看下方的更新状态。"

msgid "Update"
msgstr "更新"

msgid "Do you really want to download the latest CloudDrive2 release for the selected channel and restart the service? Your CloudDrive2 configuration and data are kept."
msgstr "确定要下载所选渠道的最新 CloudDrive2 版本并重启服务吗？您的 CloudDrive2 配置和数据将被保留。"

msgid "Updating CloudDrive2"
msgstr "正在更新 CloudDrive2"
